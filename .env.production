# Production Environment Variables Template
# Copy this to .env and fill in your production values

# Application Settings
APP_NAME="Brain Tumor Detection API"
APP_VERSION="1.0.0"
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=10000

# CORS Settings (Update with your Render frontend URL)
ALLOWED_ORIGINS=["https://your-frontend.onrender.com", "https://www.yourdomain.com"]

# Model Configuration
MODEL_PATH=./model/final_brain_tumor_model_97.keras
MODEL_INPUT_SIZE=224
CONFIDENCE_THRESHOLD=0.5

# Data Paths (relative to backend directory in production)
TRAINING_HISTORY_PATH=./model_training_phase/training_history.csv
TRAINING_HISTORY_2_PATH=./model_training_phase/training_history_2.csv
MODEL_PREDICTIONS_PATH=./model_training_phase/model_predictions.csv
TEST_IMAGES_PATH=./image/test_image

# Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png"]

# Logging
LOG_LEVEL=INFO

# Security (Add these in Render dashboard as secret env vars)
# API_KEY_SECRET=your-secret-key-here
# DATABASE_URL=your-database-url-if-needed
